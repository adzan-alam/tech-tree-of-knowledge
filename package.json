  "description": "An expandable, interconnected, and generative knowledge infrastructure for human civilization.",
  "author": "Adzan Alam & Antigravity",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/tests/**/*.test.js || tsx --test tests/**/*.test.ts",
    "test:ts": "tsx --test tests/**/*.test.ts",
    "validate": "tsx src/cli/validate.ts",
    "graph:check": "tsx src/cli/graph.ts check",
    "graph:path": "tsx src/cli/graph.ts pathway",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
