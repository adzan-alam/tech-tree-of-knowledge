{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://techtree.org/schemas/assessment.schema.json",
  "title": "TechTreeModuleAssessment",
  "description": "Validation schema for module evaluation assessments and rubrics (assessment.yaml).",
  "type": "object",
  "required": [
    "module_slug",
    "passing_threshold_percent",
    "questions"
  ],
  "properties": {
    "module_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "passing_threshold_percent": {
      "type": "number",
      "minimum": 50,
      "maximum": 100
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "target_objective_id",
          "prompt",
          "type",
          "explanation"
        ],
        "properties": {
          "id": { "type": "string" },
          "target_objective_id": { "type": "string" },
          "prompt": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "multiple_choice",
              "numerical_calculation",
              "symbolic_derivation",
              "code_implementation"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text", "is_correct"],
              "properties": {
                "id": { "type": "string" },
                "text": { "type": "string" },
                "is_correct": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "numerical_solution": {
            "type": "object",
            "required": ["value", "tolerance", "unit"],
            "properties": {
              "value": { "type": "number" },
              "tolerance": { "type": "number", "minimum": 0 },
              "unit": { "type": "string" }
            },
            "additionalProperties": false
          },
          "explanation": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
